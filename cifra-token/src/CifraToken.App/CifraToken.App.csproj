<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CifraToken</AssemblyName>
    <Product>CifraToken</Product>
    <Description>Cifra e decifra arquivos em CMS (.p7m) com certificado ICP-Brasil em token</Description>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CifraToken.Core\CifraToken.Core.csproj" />
  </ItemGroup>
</Project>
