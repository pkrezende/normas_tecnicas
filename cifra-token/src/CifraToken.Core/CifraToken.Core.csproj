<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Pkcs11Interop" Version="5.3.0" />
    <!-- 6.2.4 é a última versão MIT; a 6.5.0 (14/10/2026) passou para AGPL-3.0 -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="fontes\*.ttf" LogicalName="fontes.%(Filename)%(Extension)" />
    <!-- a SIL OFL pede que a licença acompanhe as fontes -->
    <Content Include="fontes\LICENCA-OFL.txt" Link="LICENCA-FONTES-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
